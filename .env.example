# Copy to .env for local overrides. Never put real credentials or personal data here:
# every customer used by the suite is synthetic and created per scenario.

# Target environment (src/support/environments.ts):
#   qa   http://localhost:8090/parabank/ (default)
#   uat  http://localhost:8091/parabank/
# QA and UAT are deployed by image ID with `npm run qa:deploy` / `npm run uat:deploy`.
TARGET_ENV=qa
# Only when the environment is not reached through localhost (e.g. a Jenkins container agent).
# PARABANK_BASE_URL=http://parabank-qa-parabank-1:8080/parabank/

# Browser execution
HEADLESS=true
SLOW_MO=0

# Keep one worker: ParaBank's registration is not safe under concurrency (PB-20). No retries.
CUCUMBER_PARALLEL=1
CUCUMBER_RETRY=0

# Opt-in Playwright traces for failed scenarios (written to reports/traces).
# Traces capture network traffic, which includes the synthetic customer's password, so keep
# them local and never upload them from CI.
PW_TRACE_ON_FAILURE=false

# Opt-in per-scenario request accounting
# (reports/network-diagnostics.jsonl: methods, redacted paths, statuses, safe headers only).
NET_DIAG=false
