# The ParaBank application source this project builds and tests: one immutable commit of the
# official repository (never a branch name). Changing it is a deliberate, reviewed upgrade.
# Read by scripts/build-parabank-image.ts and passed to docker/parabank/Dockerfile.
PARABANK_SOURCE_REPO=https://github.com/parasoft/parabank.git
